{
  "expo": {
    "name": "TaskFlow",
    "slug": "taskflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/taskflow-logo.png",
    "scheme": "taskflow",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/taskflow-logo.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.nyayath.TaskReminderApp"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#172033",
        "foregroundImage": "./assets/images/taskflow-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nyayath.TaskReminderApp"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/taskflow-logo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#172033",
          "image": "./assets/images/taskflow-logo.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-notifications",
      "expo-web-browser",
      "expo-sharing"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1199a26-bb75-4013-8b3e-d52cc8b5bb65"
      }
    }
  }
}